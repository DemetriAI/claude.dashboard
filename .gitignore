# Raw prospect teardown source files may contain PII/PHI — keep out of git by default.
# (Prep docs in calls/*_prep.md are tracked; move real ones out if they hold sensitive data.)
teardowns/
calls/teardowns/

# Engine: enriched contact exports (emails/phones) are PII — keep out of git.
# The _private/ folder stays in the repo (its README is tracked); its contents do not.
engine/**/_private/*
!engine/**/_private/README.md

# OS / editor cruft
.DS_Store
*.swp
*~

# Python build cruft (from engine/tools/*.py)
__pycache__/
*.pyc
